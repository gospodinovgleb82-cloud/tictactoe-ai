<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#07070f"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvDifficulty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Сложность: Сложный  |  3×3"
        android:textSize="12sp"
        android:textColor="#5a5a7a"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:id="@+id/tvScore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Вы: 0  |  AI: 0  |  Ничья: 0"
        android:textSize="13sp"
        android:textColor="#a78bfa"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ваш ход (X)"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#e8e8f5"
        android:layout_marginBottom="24dp"/>

    <GridLayout
        android:id="@+id/gridBoard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:rowCount="3"
        android:columnCount="3"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/btnNewGame"
        android:layout_width="260dp"
        android:layout_height="52dp"
        android:text="Новая игра"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:backgroundTint="#7c3aed"/>

</LinearLayout>