<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#07070f"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/rootSelect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvSelectTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Настройки игры"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#e8e8f5"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"/>

        <!-- Board size card -->
        <LinearLayout
            android:id="@+id/cardSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1a1a2e"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="РАЗМЕР ПОЛЯ"
                android:textSize="11sp"
                android:textColor="#5a5a7a"
                android:letterSpacing="0.15"
                android:layout_marginBottom="12dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn3x3"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="48dp"
                    android:text="3 × 3"
                    android:textSize="13sp"
                    android:textColor="#ffffff"
                    android:backgroundTint="#7c3aed"
                    android:layout_marginEnd="8dp"/>

                <Button
                    android:id="@+id/btn4x4"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="48dp"
                    android:text="4 × 4"
                    android:textSize="13sp"
                    android:textColor="#ffffff"
                    android:backgroundTint="#1a1a2e"
                    android:layout_marginEnd="8dp"/>

                <Button
                    android:id="@+id/btn5x5"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="48dp"
                    android:text="5 × 5"
                    android:textSize="13sp"
                    android:textColor="#ffffff"
                    android:backgroundTint="#1a1a2e"/>

            </LinearLayout>
        </LinearLayout>

        <!-- Difficulty card -->
        <LinearLayout
            android:id="@+id/cardDiff"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1a1a2e"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="СЛОЖНОСТЬ AI"
                android:textSize="11sp"
                android:textColor="#5a5a7a"
                android:letterSpacing="0.15"
                android:layout_marginBottom="12dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnEasy"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="48dp"
                    android:text="Лёгкий"
                    android:textSize="13sp"
                    android:textColor="#ffffff"
                    android:backgroundTint="#1a1a2e"
                    android:layout_marginEnd="8dp"/>

                <Button
                    android:id="@+id/btnMedium"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="48dp"
                    android:text="Средний"
                    android:textSize="13sp"
                    android:textColor="#ffffff"
                    android:backgroundTint="#1a1a2e"
                    android:layout_marginEnd="8dp"/>

                <Button
                    android:id="@+id/btnHard"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="48dp"
                    android:text="Сложный"
                    android:textSize="13sp"
                    android:textColor="#ffffff"
                    android:backgroundTint="#7c3aed"/>

            </LinearLayout>
        </LinearLayout>

        <!-- Preview card -->
        <LinearLayout
            android:id="@+id/cardPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1a1a2e"
            android:padding="16dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/tvPreviewLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ПРЕДПРОСМОТР"
                android:textSize="11sp"
                android:textColor="#5a5a7a"
                android:letterSpacing="0.15"
                android:layout_marginBottom="6dp"/>

            <TextView
                android:id="@+id/tvPreview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Поле 3×3 · AI никогда не проигрывает"
                android:textSize="14sp"
                android:textColor="#a78bfa"
                android:singleLine="true"
                android:ellipsize="none"/>

        </LinearLayout>

        <Button
            android:id="@+id/btnPlay"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Играть!"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:backgroundTint="#7c3aed"
            android:layout_marginBottom="10dp"/>

        <Button
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="← Назад"
            android:textSize="14sp"
            android:textColor="#5a5a7a"
            android:backgroundTint="#1a1a2e"/>

    </LinearLayout>
</ScrollView>
