<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#07070f"
    android:padding="32dp">

    <!-- Logo section -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginBottom="40dp">

        <TextView
            android:id="@+id/tvLogoSymbols"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✕  ○"
            android:textSize="56sp"
            android:textColor="#a78bfa"
            android:layout_marginBottom="12dp"
            android:letterSpacing="0.1"/>

        <TextView
            android:id="@+id/tvAppTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TicTacToe AI"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#e8e8f5"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Сможешь победить Minimax?"
            android:textSize="14sp"
            android:textColor="#5a5a7a"
            android:layout_marginBottom="16dp"/>

        <View
            android:id="@+id/divider"
            android:layout_width="48dp"
            android:layout_height="3dp"
            android:background="#7c3aed"
            android:layout_gravity="center_horizontal"/>
    </LinearLayout>

    <!-- Buttons -->
    <Button
        android:id="@+id/btnStart"
        android:layout_width="280dp"
        android:layout_height="56dp"
        android:text="Начать игру"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:backgroundTint="#7c3aed"
        android:layout_marginBottom="10dp"/>

    <Button
        android:id="@+id/btnSettings"
        android:layout_width="280dp"
        android:layout_height="52dp"
        android:text="⚙  Настройки"
        android:textSize="15sp"
        android:textColor="#a78bfa"
        android:backgroundTint="#1a1a2e"
        android:layout_marginBottom="10dp"/>

    <Button
        android:id="@+id/btnExit"
        android:layout_width="280dp"
        android:layout_height="52dp"
        android:text="Выйти"
        android:textSize="15sp"
        android:textColor="#5a5a7a"
        android:backgroundTint="#1a1a2e"/>

    <TextView
        android:id="@+id/tvTechLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Minimax + Alpha-Beta Pruning"
        android:textSize="11sp"
        android:textColor="#3a3a5a"
        android:layout_marginTop="28dp"/>

</LinearLayout>
