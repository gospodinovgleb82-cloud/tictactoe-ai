<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#07070f">

    <LinearLayout
        android:id="@+id/rootSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="#07070f">

        <TextView
            android:id="@+id/tvSettingsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Настройки"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#e8e8f5"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"/>

        <!-- Theme card -->
        <LinearLayout
            android:id="@+id/cardTheme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1a1a2e"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvThemeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ТЕМА ОФОРМЛЕНИЯ"
                android:textSize="11sp"
                android:textColor="#5a5a7a"
                android:letterSpacing="0.15"
                android:layout_marginBottom="16dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnThemeDark"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="🌑"
                    android:textSize="20sp"
                    android:backgroundTint="#7c3aed"
                    android:layout_marginEnd="8dp"/>

                <Button
                    android:id="@+id/btnThemeLight"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="☀️"
                    android:textSize="20sp"
                    android:backgroundTint="#1a1a2e"
                    android:layout_marginEnd="8dp"/>

                <Button
                    android:id="@+id/btnThemeRed"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="🔴"
                    android:textSize="20sp"
                    android:backgroundTint="#1a1a2e"
                    android:layout_marginEnd="8dp"/>

                <Button
                    android:id="@+id/btnThemeCyan"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="🩵"
                    android:textSize="20sp"
                    android:backgroundTint="#1a1a2e"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Тёмная"
                    android:textSize="10sp"
                    android:textColor="#5a5a7a"
                    android:gravity="center"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Светлая"
                    android:textSize="10sp"
                    android:textColor="#5a5a7a"
                    android:gravity="center"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Красная"
                    android:textSize="10sp"
                    android:textColor="#5a5a7a"
                    android:gravity="center"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Циановая"
                    android:textSize="10sp"
                    android:textColor="#5a5a7a"
                    android:gravity="center"/>

            </LinearLayout>

        </LinearLayout>

        <Button
            android:id="@+id/btnBackSettings"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="← Назад"
            android:textSize="15sp"
            android:textColor="#5a5a7a"
            android:backgroundTint="#1a1a2e"
            android:layout_marginTop="8dp"/>

    </LinearLayout>
</ScrollView>
