<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootGame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#07070f"
    android:padding="16dp">

    <!-- Top bar: diff + score -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/tvDifficulty"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Сложный · 3×3"
            android:textSize="12sp"
            android:textColor="#5a5a7a"/>

        <TextView
            android:id="@+id/tvScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Вы: 0 · AI: 0 · Ничья: 0"
            android:textSize="12sp"
            android:textColor="#a78bfa"/>
    </LinearLayout>

    <!-- Status -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ваш ход (X)"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#e8e8f5"
        android:gravity="center"
        android:layout_marginBottom="8dp"/>

    <!-- Advantage bar -->
    <LinearLayout
        android:id="@+id/advantageContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="3dp">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="ВЫ"
                android:textSize="10sp"
                android:textColor="#4ade80"/>

            <TextView
                android:id="@+id/tvAdvPct"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="50%"
                android:textSize="10sp"
                android:textColor="#5a5a7a"/>

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="AI"
                android:textSize="10sp"
                android:textColor="#f87171"
                android:gravity="end"/>
        </LinearLayout>

        <!-- Bar background -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:background="#1a1a2e">

            <!-- Human advantage fill (left side) -->
            <View
                android:id="@+id/advBarHuman"
                android:layout_width="0dp"
                android:layout_height="8dp"
                android:layout_gravity="start"
                android:background="#4ade80"/>

        </FrameLayout>

    </LinearLayout>

    <!-- Board -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center">

        <GridLayout
            android:id="@+id/gridBoard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:rowCount="3"
            android:columnCount="3"/>

    </FrameLayout>

    <!-- AI Taunt box -->
    <LinearLayout
        android:id="@+id/tauntCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1a1a2e"
        android:padding="12dp"
        android:layout_marginBottom="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🤖  ИИ говорит:"
            android:textSize="10sp"
            android:textColor="#5a5a7a"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvTaunt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Инициализация…"
            android:textSize="13sp"
            android:textColor="#a78bfa"
            android:fontFamily="monospace"/>

        <!-- Panic loading bar (hidden by default) -->
        <View
            android:id="@+id/panicBar"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:background="#f87171"
            android:visibility="gone"
            android:layout_marginTop="8dp"/>

    </LinearLayout>

    <!-- New game button -->
    <Button
        android:id="@+id/btnNewGame"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Новая игра"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:backgroundTint="#7c3aed"/>

</LinearLayout>
